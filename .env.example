# Current runnable profile: Qwen3.8-27B-NVFP4, TP=2, MTP=1.
# Other historical deployments are indexed in profiles/deployments.yaml.
# Copy this file to .env and edit every value marked CHANGE_ME.
# Values are parsed by Bash; do not put spaces around '='.

# Cluster and SSH
WORKER_SSH=CHANGE_ME@spark-worker.local
HEAD_IP=10.100.32.1
WORKER_IP=10.100.32.2
FABRIC_NIC=enp1s0f1np1
FABRIC_HCA=rocep1s0f1

# Runtime. The tag is convenient; EXPECTED_IMAGE_ID makes it reproducible.
IMAGE=vllm/vllm-openai:nightly
EXPECTED_IMAGE_ID=sha256:177a406d7cb2a11338bcd8c67ab7590b330799cdc5a3193ac0ca40728ea2501b

# Hugging Face cache layout. Keep the same absolute path and revision on both nodes.
MODEL_REPO=/home/CHANGE_ME/.cache/huggingface/hub/models--unsloth--Qwen3.8-27B-NVFP4
MODEL_REV=7d6f8d4d72f56b92b3cdbf22f156b90e1bab0108
SERVED_MODEL=unsloth/Qwen3.8-27B-NVFP4

# Service identity and ports
CONTAINER_PREFIX=qwen38-27b-nvfp4-tp2
MASTER_PORT=29501
API_BIND=127.0.0.1
API_PORT=8888
API_KEY=
ALLOW_REMOTE_API=false

# vLLM sizing
MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.75
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
REASONING_PARSER=qwen3
QUANTIZATION=

# Native Qwen3.5/Qwen3.8 MTP. This checkpoint contains one MTP layer.
ENABLE_MTP=true
SPEC_METHOD=mtp
SPEC_TOKENS=1

# Optional OpenAI tool-call parsing
ENABLE_AUTO_TOOL_CHOICE=false
TOOL_CALL_PARSER=qwen3_coder

# Diagnostics
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,NET
STARTUP_TIMEOUT_SECONDS=720

# Smoke request
SMOKE_PROMPT=用一句话介绍张量并行。
SMOKE_MAX_TOKENS=96
SMOKE_TEMPERATURE=0
DISABLE_THINKING=true
